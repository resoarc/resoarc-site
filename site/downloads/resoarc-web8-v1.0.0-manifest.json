{
  "release": "ResoArc Web Diagnostics",
  "version": "1.0.0",
  "date": "2026-10-16",
  "category": "browser-only offline diagnostics",
  "scope": "8 web utilities only",
  "kintonePluginStatus": "NOT_GA - independent kintone tenant acceptance pending",
  "zip": "resoarc-web8-v1.0.0-source.zip",
  "sha256": "d9bee5d112c706b322037d4c2a595d24d39148b1d84e00856732f48114526374",
  "tools": [
    {
      "path": "/tools/kintone-bulk-preview/",
      "name": "一括更新・変更前プレビュー",
      "limitation": "データへの書き込みは行いません。JSON／CSVのファイル照合のみです。"
    },
    {
      "path": "/tools/kintone-app-diff/",
      "name": "アプリ設定JSON差分比較",
      "limitation": "設定JSONの構造的差分の表示のみです。実際のkintoneアプリの変更・同期は行いません。"
    },
    {
      "path": "/tools/kintone-permission-audit/",
      "name": "権限定義の可視化",
      "limitation": "定義を一覧化するだけです。ユーザー・グループに適用される実効権限は判定しません。"
    },
    {
      "path": "/tools/kintone-import-check/",
      "name": "CSV取込前診断",
      "limitation": "取り込みの成功を保証しません。テーブル行、ルックアップなど未対応の形式があります。"
    },
    {
      "path": "/tools/kintone-duplicates/",
      "name": "重複レコード候補の検出",
      "limitation": "文字列正規化による候補抽出であり、重複レコードの削除はしません。"
    },
    {
      "path": "/tools/kintone-lookup-audit/",
      "name": "ルックアップ不整合診断",
      "limitation": "手元の2ファイルを比較する静的診断です。参照関係の自動更新はしません。"
    },
    {
      "path": "/tools/kintone-cross-aggregate/",
      "name": "統合済みCSV／JSON集計",
      "limitation": "統合済みデータを入力します。異なるkintoneアプリの直接API取得は行いません。"
    },
    {
      "path": "/tools/kintone-print-report/",
      "name": "ブラウザ帳票／PDF保存",
      "limitation": "PDFはブラウザの印刷機能で保存します。帳票サーバーやPDF生成APIは使いません。"
    }
  ],
