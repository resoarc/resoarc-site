{
  "format": "qaiuick-spec-v1",
  "id": "resoarc-qaiuick-spec-inventory",
  "version": 1,
  "title": "在庫管理・仕様駆動版",
  "description": "部品を登録し、補充ライン以下の在庫を見つけます。",
  "persist": "local",
  "theme": "teal",
  "fields": {
    "name": {
      "label": "品目名",
      "type": "text",
      "required": true,
      "default": ""
    },
    "category": {
      "label": "分類",
      "type": "select",
      "required": false,
      "options": [
        "部品",
        "工具",
        "消耗品"
      ],
      "default": "部品"
    },
    "qty": {
      "label": "在庫数",
      "type": "number",
      "required": false,
      "min": 0,
      "default": 0
    },
    "limit": {
      "label": "補充ライン",
      "type": "number",
      "required": false,
      "min": 0,
      "default": 5
    }
  },
  "ui": {
    "columns": [
      "name",
      "category",
      "qty",
      "limit"
    ],
    "search": [
      "name",
      "category"
    ]
  },
  "sample": [
    {
      "id": "s1",
      "name": "M3ボルト",
      "category": "部品",
      "qty": 48,
      "limit": 20
    },
    {
      "id": "s2",
      "name": "USB-Cケーブル",
      "category": "部品",
      "qty": 8,
      "limit": 12
    },
    {
      "id": "s3",
      "name": "養生テープ",
      "category": "消耗品",
      "qty": 6,
      "limit": 5
    }
  ],
  "metrics": {
    "low": {
      "label": "補充対象",
      "logic": "rows => rows.filter(r => r.qty < r.limit).length"
    }
  },
  "actions": {
    "restock": {
      "label": "+10",
      "description": "選択品目の在庫を10増やす",
      "logic": "({ record, update }) => update(record.id, { qty: record.qty + 10 })"
    }
  }
}
