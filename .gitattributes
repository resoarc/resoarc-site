# Preserve canonical LF bytes for cross-platform deterministic SHA-256 checks.
# GitHub Actions (Linux) and Windows must hash the same checked-out sources.
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.sha256 text eol=lf
site/_headers text eol=lf
*.woff2 binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
# Published release companion files must retain exact bytes matching release SHA.
site/downloads/resoarc-2plugins-* binary

# Keep the exact checked bytes of wave2 release companion documents.
site/downloads/resoarc-wave2-* binary

# Fixed rights documents: exact SHA-256 published bytes.
site/downloads/resoarc-readonly4-* binary

# Preserve release ZIP and companion documentation exactly.
site/downloads/resoarc-tabs-v1.0.0-* binary
