    "en": "https://resoarc.com/products/kintone/"
  },
  "desktop": {
    "js": [
      "js/desktop.js"
    ]
  },
  "mobile": {
    "js": [
      "js/mobile.js"
    ]
  },
  "config": {
    "html": "html/config.html",
    "js": [
      "js/config.js"
    ],
    "css": [
      "css/config.css"
    ],
    "required_params": [
      "rules"
    ]
  }
