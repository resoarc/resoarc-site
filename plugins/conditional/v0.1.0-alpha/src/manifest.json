{
  "manifest_version": 1,
  "version": "0.1.0",
  "type": "APP",
  "name": {
    "ja": "ResoArc 条件付き表示",
    "en": "ResoArc Conditional Fields"
  },
  "description": {
    "ja": "条件付きのフィールド表示と保存時入力チェック。データを消さない方式。",
